---
import Plate from "./Plate.astro";
import { contacts } from "../data/site";
---
<div class="mbar" data-mbar>
  <Plate href={contacts.phoneHref} tone="red" icon="phone" label={`Зателефонувати ${contacts.phoneText}`}>Зателефонувати</Plate>
  <Plate href={contacts.telegram} tone="graphite" icon="telegram" external label="Написати в Telegram">Telegram</Plate>
</div>

<style is:global>
  .mbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--color-primary);
  }
  .mbar .plate { justify-content: center; min-height: var(--bar-h); }
  @media (min-width: 1100px) { .mbar { display: none; } }

  /* Motion 5: the bar slides up once the hero has left the view */
  .js .mbar { transform: translateY(100%); transition: transform 220ms var(--ease-out); }
  .js .mbar.is-shown { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .js .mbar { transition: none; } }
</style>
