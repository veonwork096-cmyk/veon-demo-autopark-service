---
import { Picture } from "astro:assets";
import hall from "../assets/photos/hall-panorama.jpg";
import Section from "./Section.astro";
import Plate from "./Plate.astro";
import LvivTime from "./LvivTime.astro";
import { contacts } from "../data/site";
---
<Section id="hero" rec="R-D01,R-D04,R-D05,R-D20" class="hero">
  <div class="container hero__grid">
    <h1 class="hero__title">Цілодобове СТО мережі Autopark у Львові</h1>
    <p class="hero__lead">ТО, ремонт, кузов, електромобілі. Для приватних і корпоративних авто, у вихідні та свята теж.</p>
    <div class="hero__action">
      <div class="hero__plates" data-rec="R-D15,M-R005">
        <Plate href={contacts.phoneHref} tone="red" size="lg" icon="phone" sub={contacts.phoneText} class="hero__call">Зателефонувати</Plate>
        <Plate href={contacts.telegram} tone="graphite" size="lg" icon="telegram" external class="hero__write">Написати в Telegram</Plate>
      </div>
      <LvivTime class="hero__now" rec="R-D14" />
      <p class="hero__address">
        <span>{contacts.street}, {contacts.district}</span>
        <a class="text-link" href={contacts.maps} target="_blank" rel="noopener">Прокласти маршрут</a>
      </p>
    </div>
    <figure class="hero__photo">
      <Picture
        src={hall}
        formats={["avif", "webp"]}
        widths={[480, 800, 1280]}
        sizes="(min-width: 1440px) 1360px, calc(100vw - 2.5rem)"
        alt="Світлий зал станції Autopark Service: седан на підйомнику"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
    </figure>
  </div>
</Section>

<style is:global>
  .hero { padding-top: var(--space-4); }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .hero__title { font-size: var(--fs-6); line-height: 1.04; letter-spacing: -0.01em; max-width: 14ch; }
  .hero__lead { font-size: var(--fs-3); max-width: 34ch; color: var(--color-text); }
  .hero__action { display: grid; gap: var(--space-2); }
  .now {
    align-items: baseline;
    display: flex;
    gap: 0.625rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-time);
    line-height: 1.2;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .now__mark { flex: none; transform: translateY(-0.12em); width: 0.5rem; height: 0.5rem; background: var(--color-accent); }
  .hero__plates { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero__plates .plate { width: 100%; }
  .hero .plate--lg { min-height: var(--plate-h); }
  .hero__address { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-3); color: var(--color-muted); }
  .hero__address span { color: var(--color-text); }
  .hero__photo { margin: var(--space-2) 0 0; overflow: hidden; }
  .hero__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 30%; }

  @media (min-width: 768px) {
    .hero__plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .hero { padding-top: var(--space-5); }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      row-gap: var(--space-4);
    }
    .hero__title { grid-column: 1 / -1; max-width: none; }
    .hero__lead { grid-column: 1 / span 5; align-self: start; padding-top: var(--space-1); }
    .hero__action { grid-column: 7 / span 6; }
    .hero .plate--lg { min-height: var(--plate-h-lg); }
    .hero__photo { grid-column: 1 / -1; margin-top: 0; }
    .hero__img { aspect-ratio: 1360 / 330; object-position: 50% 12%; }
  }

  /* Motion 1: the hall panorama opens bottom-up once on load ("light in the hall is on"); text is already in place */
  @keyframes hall-open { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }
  .js .hero__photo { animation: hall-open 500ms var(--ease-out) 120ms both; }
  @media (min-width: 1100px) { .js .hero__photo { animation-duration: 700ms; } }
  @media (prefers-reduced-motion: reduce) { .js .hero__photo { animation: none; } }
</style>
