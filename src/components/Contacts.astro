---
import Section from "./Section.astro";
import Plate from "./Plate.astro";
import LvivTime from "./LvivTime.astro";
import { contacts } from "../data/site";
---
<Section id="contacts" rec="R-D03,R-D10" class="contacts">
  <div class="container contacts__grid">
    <h2 class="contacts__title">{contacts.street}<span class="contacts__sub">Працюємо цілодобово</span></h2>
    <div class="contacts__info">
      <p class="contacts__district">{contacts.district}</p>
      <LvivTime />
      <div class="contacts__plates">
        <Plate href={contacts.phoneHref} tone="red" size="lg" icon="phone" sub={contacts.phoneText}>Зателефонувати</Plate>
        <Plate href={contacts.telegram} tone="graphite" size="lg" icon="telegram" external>Написати в Telegram</Plate>
      </div>
      <ul class="contacts__links">
        <li><a class="text-link" href={contacts.maps} target="_blank" rel="noopener">Прокласти маршрут</a></li>
        <li><a class="text-link" href={contacts.emailHref}>{contacts.email}</a></li>
        <li><a class="text-link" href={contacts.facebook} target="_blank" rel="noopener">Facebook</a></li>
        <li><a class="text-link" href={contacts.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>
  </div>
</Section>

<style is:global>
  .contacts { padding-block: var(--section-y); border-top: 1px solid var(--color-border); }
  .contacts__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .contacts__title { font-size: var(--fs-7); line-height: 0.98; letter-spacing: -0.015em; }
  .contacts__sub { display: block; margin-top: var(--space-2); font-size: var(--fs-4); font-weight: 600; letter-spacing: 0; color: var(--color-muted); }
  .contacts__info { display: grid; gap: var(--space-3); align-content: start; }
  .contacts__district { font-size: var(--fs-3); }
  .contacts__plates { display: grid; grid-template-columns: minmax(0, 1fr); }
  .contacts__plates .plate { width: 100%; }
  .contacts .plate--lg { min-height: var(--plate-h); }
  .contacts__links { display: flex; flex-wrap: wrap; column-gap: var(--space-4); }
  .contacts__links a { overflow-wrap: anywhere; }
  @media (min-width: 768px) {
    .contacts__plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .contacts__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .contacts__title { grid-column: 1 / -1; }
    .contacts__info { grid-column: 1 / span 7; }
    .contacts .plate--lg { min-height: var(--plate-h-lg); }
  }
</style>
